rules_version = '2';

// Security rules for Finance Book.
// Paste this whole file into: Firebase console → Firestore Database → Rules → Publish.
//
// - Every signed-in user has exactly one document: users/{their uid}.
// - A user can only read/write/delete their OWN document; everything else is denied.
// - Email/password accounts must have a verified email (Google accounts always do).
// - The document only ever contains the locked (wrapped) key and encrypted data,
//   so even with console access the contents cannot be read (see js/vault.js).
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      function isOwner() {
        return request.auth != null
          && request.auth.uid == uid
          && request.auth.token.email_verified == true;
      }

      function validShape() {
        let d = request.resource.data;
        return d.keys().hasOnly(['v', 'kdf', 'pw', 'rec', 'data', 'rev', 'updatedAt'])
          && d.keys().hasAll(['v', 'kdf', 'pw', 'rec', 'data', 'rev', 'updatedAt'])
          && d.v == 1
          && d.rev is int
          && d.updatedAt == request.time
          && d.kdf is map && d.kdf.iter is int && d.kdf.iter >= 600000
          && d.pw is map && d.rec is map
          && d.data is map && d.data.ct is string && d.data.iv is string;
      }

      allow get: if isOwner();
      allow list: if false;
      allow create: if isOwner() && validShape() && request.resource.data.rev == 1;
      allow update: if isOwner() && validShape() && request.resource.data.rev == resource.data.rev + 1;
      allow delete: if isOwner();
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
