rules_version = '2';

// Security rules for Finance Book.
// Paste this whole file into: Firebase console → Firestore Database → Rules → Publish.
//
// - Every signed-in user has exactly one document: users/{their uid}.
// - A user can only read/write/delete their OWN document; everything else is denied.
// - Email/password accounts must have a verified email (Google accounts always do).
// - Writes must have the expected shape, a server timestamp and a revision exactly
//   one higher than the stored one (so one device can't silently overwrite another).
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      function isOwner() {
        return request.auth != null
          && request.auth.uid == uid
          && request.auth.token.email_verified == true;
      }

      function validShape() {
        let d = request.resource.data;
        let fields = ['transactions', 'installments', 'recurring', 'deleted', 'settings', 'rev', 'updatedAt'];
        return d.keys().hasOnly(fields)
          && d.keys().hasAll(fields)
          && d.transactions is list
          && d.installments is list
          && d.recurring is list
          && d.deleted is map
          && (d.settings == null || d.settings is map)
          && d.rev is int
          && d.updatedAt == request.time;
      }

      allow get: if isOwner();
      allow list: if false;
      allow create: if isOwner() && validShape() && request.resource.data.rev == 1;
      allow update: if isOwner() && validShape() && request.resource.data.rev == resource.data.rev + 1;
      allow delete: if isOwner();
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
